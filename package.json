{
  "name": "knowledge-ui",
  "version": "1.0.0",
  "author": "datassist",
  "private": true,
  "scripts": {
    "run:local": "next dev",
    "run:dev": "env-cmd -f .env.dev next dev",
    "run:test": "env-cmd -f .env.test next dev",
    "run:production": "env-cmd -f .env.prod next dev",
    "build:local": "next build",
    "build:dev": "env-cmd -f .env.dev next build",
    "build:test": "env-cmd -f .env.test next build",
    "build:prod": "env-cmd -f .env.prod next build",
    "serve:local": "next start",
    "serve:dev": "env-cmd -f .env.dev next start",
    "serve:test": "env-cmd -f .env.test next start",
    "serve:prod": "env-cmd -f .env.prod next start",
    "prettier": "prettier --write '**/*.{js,jsx,mjs,ts,tsx,mdx}'",
    "lint": "eslint . --ext .ts,.js,.tsx,.jsx",
    "lint:fix": "eslint . --ext .ts,.js,.tsx,.jsx --fix",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dakika/auth": "2.1.0",
    "@datassist/ui-shell-next": "^0.1.9",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/server": "^11.11.0",
    "@emotion/styled": "^11.14.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@fontsource/roboto-mono": "^5.3.0",
    "@mui/icons-material": "^6.5.0",
    "@mui/material": "^6.5.0",
    "@mui/system": "^6.5.0",
    "@mui/utils": "^6.4.9",
    "@mui/x-date-pickers": "^7.29.4",
    "@phosphor-icons/react": "^2.1.10",
    "axios": "^1.19.0",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.23",
    "env-cmd": "^10.1.0",
    "i18next": "^26.4.0",
    "lodash.startcase": "^4.4.0",
    "next": "14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.12",
    "sonner": "^2.0.8",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@svgr/webpack": "^8.1.0",
    "@trivago/prettier-plugin-sort-imports": "^4.3.0",
    "@types/crypto-js": "^4.2.2",
    "@types/lodash.startcase": "^4.4.9",
    "@types/node": "^20.19.9",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "autoprefixer": "^10.5.4",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-unused-imports": "^4.1.4",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.8.3"
  }
}
